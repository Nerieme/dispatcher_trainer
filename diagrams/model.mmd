classDiagram
    class ISystemElement {
        <<interface>>
        +id() string
        +kind() string
        +status() string
        +summary() string
    }

    class IVisualDescriptorProvider {
        <<interface>>
        +toVisualDescriptor() VisualDescriptor
    }

    class Room {
        -string id_
        -string name_
        -string building_
        -ElementStatus status_
        +Room(id, name, building, status)
        +id() string
        +kind() string
        +status() string
        +summary() string
        +toVisualDescriptor() VisualDescriptor
        +building() const string&
        +setStatus(ElementStatus)
    }

    class Brigade {
        -string id_
        -string name_
        -string baseBuilding_
        -bool busy_
        +Brigade(id, name, baseBuilding, busy)
        +id() string
        +kind() string
        +status() string
        +summary() string
        +toVisualDescriptor() VisualDescriptor
        +baseBuilding() const string&
        +setBusy(bool)
    }

    class Alarm {
        -string id_
        -string roomId_
        -Severity severity_
        +Alarm(id, roomId, severity)
        +id() string
        +kind() string
        +status() string
        +summary() string
        +toVisualDescriptor() VisualDescriptor
        +roomId() const string&
    }

    class Incident {
        -string id_
        -string roomId_
        -string building_
        -Severity severity_
        -bool closed_
        +Incident(id, roomId, building, severity, closed)
        +id() string
        +kind() string
        +status() string
        +summary() string
        +toVisualDescriptor() VisualDescriptor
        +roomId() const string&
        +building() const string&
        +close()
    }

    class ARHint {
        -string id_
        -string text_
        -string anchorId_
        -int priority_
        +ARHint(id, text, anchorId, priority)
        +id() string
        +kind() string
        +status() string
        +summary() string
        +toVisualDescriptor() VisualDescriptor
        +anchorId() const string&
        +priority() int
    }

    class VisualDescriptor {
        +string id
        +string visualKind
        +string label
        +string color
        +int priority
        +string anchorId
    }

    class ConsoleVisualRenderer {
        +render(vector~VisualDescriptor~) void
    }

    class DispatcherModel {
        -vector~unique_ptr~ISystemElement~~ elements_
        +addElement(unique_ptr~ISystemElement~)
        +printSummary() void
        +collectVisualDescriptors() vector~VisualDescriptor~
        +size() size_t
    }

    class ElementStatus {
        <<enumeration>>
        Normal
        Warning
        Critical
        Offline
    }

    class Severity {
        <<enumeration>>
        Low
        Medium
        High
        Critical
    }

    ISystemElement <|-- Room
    ISystemElement <|-- Brigade
    ISystemElement <|-- Alarm
    ISystemElement <|-- Incident
    ISystemElement <|-- ARHint

    IVisualDescriptorProvider <|-- Room
    IVisualDescriptorProvider <|-- Brigade
    IVisualDescriptorProvider <|-- Alarm
    IVisualDescriptorProvider <|-- Incident
    IVisualDescriptorProvider <|-- ARHint

    Room --> ElementStatus
    Alarm --> Severity
    Incident --> Severity

    DispatcherModel o-- ISystemElement : vector~unique_ptr~
    ConsoleVisualRenderer ..> VisualDescriptor