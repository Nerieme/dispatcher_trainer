classDiagram
    class ICheckRule {
        <<interface>>
        +check() CheckResult
    }
    class RangeRule~T~ {
        -const Parameter~T~& parameter_
        -Range~T~ normalRange_
        -string problemMessage_
        +check() CheckResult
    }
    class Range~T~ {
        +T min
        +T max
        +contains(const T&) bool
    }
    class Parameter~T~ {
        -string id_
        -string label_
        -T value_
        -string unit_
        +id() const string&
        +label() const string&
        +unit() const string&
        +value() const T&
        +setValue(T)
    }
    class CheckResult {
        +string parameterId
        +string message
        +Severity severity
    }
    class VisualDescriptor {
        +string objectId
        +string visualKind
        +string label
        +string color
        +int priority
    }
    ICheckRule <|-- RangeRule~T~
    RangeRule~T~ --> Parameter~T~
    RangeRule~T~ --> Range~T~
    RangeRule~T~ ..> CheckResult
    VisualDescriptor ..> CheckResult